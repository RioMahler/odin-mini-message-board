<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Home</title>
  </head>
  <body>
    <h1>Message Board</h1>
    <a href="new">Add new message</a>
  <ul>
    <% for (let i = messages.length -1; i >= 0; i--) { %>
      <li>
       <%= messages[i].user + ": " + messages[i].text %> <br> <%= messages[i].added %> 
    <a href= <%= i %>>Show Message</a>
</li>
    <% } %>
  </ul>
</body>
</html>
